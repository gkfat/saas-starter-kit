# Firebase Admin SDK (Server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client SDK (Browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Environment — controls Firestore collection prefix
# development (or unset): uses dev_ prefix (local dev & staging)
# production: uses prod_ prefix (set this on your production deployment)
APP_ENV=development

# Tenant (used by seed scripts; runtime reads tenantId from Firebase Auth token claims)
TENANT_ID=default

# Superadmin Seed Script (scripts/seed-superadmin.ts)
# Run: npx tsx scripts/seed-superadmin.ts
# Creates a superadmin Firebase Auth account with custom claims { role: 'superadmin' }
# Login uses username + password (synthetic email: {username}@internal.local)
# Not used by the Nuxt runtime — only by the seed script.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Feature Flags — module on/off switches, build-time (require restart to take effect)
# Default: enabled. Set to 'false' to disable the module.
FEATURE_AUDIT_LOG_ENABLED=true
FEATURE_LOGIN_LOG_ENABLED=true

# CORS — comma-separated list of origins allowed to call apps/server (apps/admin, apps/liff deployed URLs)
# Example: https://admin.example.com,https://liff.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3006

# apps/admin, apps/liff — base URL of the independently deployed apps/server API
API_BASE_URL=http://localhost:3000

# Local dev server ports — only affect `pnpm dev:*`, not production (Cloud Run/Firebase Hosting)
# PORT is read directly by Nitro's dev server (apps/server); Cloud Run sets its own PORT at
# runtime and ignores this file, so there is no production conflict.
PORT=3000
ADMIN_PORT=3005
LIFF_PORT=3006
