# Firebase Admin SDK (Server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Client SDK (Browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# LINE Login / LIFF (Server-side) — used by apps/server to verify LINE/LIFF ID Tokens
# and, for apps/admin's LINE Login Web OAuth, to exchange the authorization code for a
# token. This project's channel signs ID Tokens with HS256 (symmetric), so
# channelSecret is required both for ID Token verification (HMAC key) and for the
# admin Web OAuth code exchange (client_secret) — see apps/server/server/modules/auth/auth.line.ts.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# apps/admin LINE Login (Web OAuth, browser page — not LIFF app-embedded) reuses the
# same LINE_CHANNEL_ID/SECRET above. In LINE Developers Console, under this channel's
# "LINE Login" settings, add a Callback URL for each admin environment you deploy to,
# e.g. https://admin.example.com/auth/line-callback (and http://localhost:3005/auth/line-callback
# for local dev). This is a manual, external step — not something this codebase configures.

# LINE LIFF SDK (Browser, apps/liff). apps/server also reads this (as `liffId` in
# nitro.config.ts runtimeConfig) to build `https://liff.line.me/{liffId}/...` deep links,
# e.g. the QR code shown by POST /api/profile/line-bind-code.
VITE_LIFF_ID=

# Dev-only: a real LINE access token, used to bypass liff.init()'s LINE-app-webview
# requirement when developing apps/liff in a regular desktop browser. Never set in
# production; only consumed behind an explicit dev-mode branch in chapter 6.
VITE_LIFF_ACCESS_TOKEN=

# App Environment — controls Firestore collection prefix
# development (or unset): uses dev_ prefix (local dev & staging)
# production: uses prod_ prefix (set this on your production deployment)
APP_ENV=development

# Superadmin Seed Script (scripts/seed-superadmin.ts)
# Run: npx tsx scripts/seed-superadmin.ts
# Creates a superadmin Firebase Auth account with custom claims { role: 'superadmin' }
# Login uses username + password (synthetic email: {username}@internal.local), same as
# every other account. Not used by the Nuxt runtime — only by the seed script.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Feature Flags — module on/off switches, build-time (require restart to take effect)
# Default: enabled. Set to 'false' to disable the module.
FEATURE_AUDIT_LOG_ENABLED=true
FEATURE_LOGIN_LOG_ENABLED=true
FEATURE_LEVEL_ENABLED=true
# coupon module — default disabled until at least one published template exists in admin
FEATURE_COUPON_ENABLED=false

# level module — internal batch evaluation endpoint (GCP Cloud Scheduler → apps/server)
# Shared secret required in the `X-Level-Batch-Secret` header of
# POST /api/internal/level/evaluate-due-periods. See apps/server/server/modules/level/README.md.
LEVEL_BATCH_SECRET=

# CORS — comma-separated list of origins allowed to call apps/server (apps/admin, apps/liff deployed URLs)
# Example: https://admin.example.com,https://liff.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3006

# apps/liff — base URL of the independently deployed apps/server API. Often points at a
# tunnel (e.g. ngrok) when testing the LIFF app on a real device inside the LINE app.
API_BASE_URL=http://localhost:3000

# apps/admin — base URL of the independently deployed apps/server API. Kept separate from
# API_BASE_URL so pointing apps/liff at a tunnel for device testing doesn't also redirect
# apps/admin (normally tested in a regular desktop browser against localhost) through it.
ADMIN_API_BASE_URL=http://localhost:3000

# apps/server (Server-side) — base URL of the deployed apps/liff app, used to build
# LINE bind invite links (e.g. https://liff.example.com/invite?token=...)
LIFF_APP_URL=http://localhost:3006

# apps/server (Server-side) — base URL of the deployed apps/admin app, used to build
# password setup links (e.g. https://admin.example.com/auth/set-password?token=...)
ADMIN_APP_URL=http://localhost:3005

# Local dev server ports — only affect `pnpm dev:*`, not production (Cloud Run/Firebase Hosting)
# PORT is read directly by Nitro's dev server (apps/server); Cloud Run sets its own PORT at
# runtime and ignores this file, so there is no production conflict.
PORT=3000
ADMIN_PORT=3005
LIFF_PORT=3006
