########################################
# Seed scripts — PROD-only values (loaded before scripts/env/.env by scripts/load-env.ts, so a
# key set here wins over the same key in scripts/env/.env).
#
# There is no seed:demo-users:prod — demo accounts must never be created in production.
#
# Copy to scripts/env/.env.prod and fill in. Also requires scripts/env/.env (shared) — see
# scripts/env/.env.example.
########################################

# Controls Firestore collection prefix (see apps/server/server/shared/firestore-prefix.ts).
# Must be exactly "production" for seed:rbac:prod to write to the prod_ collections.
APP_ENV=production

# Superadmin Seed Script (scripts/seed-superadmin.ts)
# NOTE: superadmin identity is Firebase Auth custom claims only — NOT Firestore-prefixed —
# so use a DIFFERENT username than scripts/env/.env.dev to avoid an account collision, and be
# aware this account's claim is valid across dev_/prod_ data in the same project.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
