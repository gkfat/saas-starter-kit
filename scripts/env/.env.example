########################################
# Seed scripts — SHARED across dev and prod (scripts/load-env.ts loads this after the
# per-env file, so per-env values always win if a key exists in both).
#
# dev and prod currently point at the SAME Firebase project (isolated only by the
# Firestore collection prefix set via APP_ENV in scripts/env/.env.dev / scripts/env/.env.prod), so the
# Admin SDK credentials below are identical for both — keep them here once instead of
# duplicating in both per-env files.
#
# Copy to scripts/env/.env and fill in.
########################################

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
