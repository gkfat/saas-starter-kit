########################################
# Seed scripts — DEV-only values (loaded before scripts/env/.env by scripts/load-env.ts, so a
# key set here wins over the same key in scripts/env/.env).
#
# Copy to scripts/env/.env.dev and fill in. Also requires scripts/env/.env (shared) — see
# scripts/env/.env.example.
########################################

# Controls Firestore collection prefix (see apps/server/server/shared/firestore-prefix.ts).
# unset or any value other than "production" → dev_ prefix
APP_ENV=development

# Superadmin Seed Script (scripts/seed-superadmin.ts)
# NOTE: superadmin identity is Firebase Auth custom claims only — NOT Firestore-prefixed —
# so use a DIFFERENT username than scripts/env/.env.prod to avoid an account collision, and be
# aware this account's claim is valid across dev_/prod_ data in the same project.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
