{
  "firestore": {
    "indexes": "firebase.indexes.json"
  },
  "hosting": [
    {
      "target": "admin",
      "public": "apps/admin/.output/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    },
    {
      "target": "liff",
      "public": "apps/liff/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}
