{
  "name": "saas-starter-kit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:admin": "pnpm --dir apps/admin dev",
    "dev:server": "pnpm --dir apps/server dev",
    "dev:liff": "pnpm --dir apps/liff dev",
    "build": "pnpm -r build",
    "lint": "eslint . && pnpm -r --if-present lint",
    "lint:fix": "eslint . --fix && pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "seed:rbac": "tsx scripts/seed-rbac.ts",
    "seed:superadmin": "tsx scripts/seed-superadmin.ts",
    "seed:demo-users": "tsx scripts/seed-demo-users.ts",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "test": "vitest run scripts && pnpm -r --if-present test"
  },
  "lint-staged": {
    "apps/admin/**/*.{ts,vue,mjs}": [
      "pnpm --dir apps/admin exec eslint --fix"
    ],
    "apps/server/**/*.ts": [
      "pnpm --dir apps/server exec eslint --fix"
    ],
    "apps/liff/**/*.{ts,vue,mjs}": [
      "pnpm --dir apps/liff exec eslint --fix"
    ],
    "scripts/**/*.ts": [
      "eslint --fix"
    ],
    "packages/shared/**/*.ts": [
      "eslint --fix"
    ],
    "*.{ts,vue,mjs,json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@saas-starter-kit/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.2+sha512.93e57b0126f0df74ce6bff29680394c0ba54ec47246b9cf321f0121d8d9bb03f750a705f24edc3c1180853afd7c2c3b94196d0a3d53d3e069d9e2793ef11f321"
}
